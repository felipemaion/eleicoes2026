{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob", "Edit", "Write",
      "Bash(uv:*)", "Bash(uvx:*)", "Bash(pytest:*)", "Bash(ruff:*)", "Bash(mypy:*)",
      "Bash(pnpm:*)", "Bash(npx:*)", "Bash(node:*)", "Bash(make:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git branch:*)",
      "Bash(git fetch:*)", "Bash(git rebase:*)", "Bash(git stash:*)", "Bash(git show:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(grep:*)",
      "Bash(find:*)", "Bash(mkdir:*)", "Bash(curl:*)", "Bash(unzip:*)", "Bash(duckdb:*)",
      "Bash(tippecanoe:*)", "Bash(./scripts/*)", "WebSearch", "WebFetch"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(git reset --hard:*)", "Bash(rm -rf:*)", "Bash(claude -p:*)",
      "Read(.env)", "Read(**/.env)", "Read(**/secrets/**)"
    ]
  }
}
